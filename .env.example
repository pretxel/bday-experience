# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development and add the same
# variables to the Vercel project settings. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Hex SHA-256 digest of the scrypt-derived access code key.
# Generate it with: npm run hash-code -- "your secret code"
ACCESS_CODE_HASH=

# Hex salt used to derive the access code key.
# Generated together with ACCESS_CODE_HASH by the same command.
ACCESS_CODE_SALT=

# Secret used to sign the session cookies with HMAC-SHA256.
# Generate it with: openssl rand -hex 32
SESSION_SECRET=

# The recipient the root path (`/`) redirects to.
# Must match the name of a file in `content/` (without the .md extension).
RECIPIENT_SLUG=ana

# Public origin of the deployment, used for canonical URLs.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Upstash Redis REST credentials — required for rate limiting in production.
# Add them from the Vercel Marketplace (Upstash Redis / Vercel KV).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
